 "lines": [
  {
   "id": "N1",
   "voice": "N",
   "text": "OpenAI-г удирддаг Сэм Алтман залуу үүсгэн байгуулагчдад хэлэв: гарааны бизнес эхлүүлэх хамгийн сайн үе яг одоо.",
   "tts": "Оупэн Эй Айг удирддаг Сэм Алтман залуу үүсгэн байгуулагчдад хэлэв: гарааны бизнес эхлүүлэх хамгийн сайн үе яг одоо.",
   "captionMap": [
    [
     "Оупэн Эй Айг",
     "OpenAI-г"
    ]
   ]
  },
  {
   "id": "N2",
   "voice": "N",
   "text": "Тэр танхимд ирээдүйн триллионер сууж байна гэж мөрийцсөн. Яагаад гэдгийг нь сонсоорой."
  },
  {
   "id": "N3",
   "voice": "N",
   "text": "2005 онд Алтман Y Combinator-ын анхны элсэлтэд байв. Тэр үед гарааны бизнес огт нэр хүндтэй зүйл биш байлаа.",
   "tts": "Хоёр мянга таван онд Алтман Уай Комбинаторын анхны элсэлтэд байв. Тэр үед гарааны бизнес огт нэр хүндтэй зүйл биш байлаа.",
   "captionMap": [
    [
     "Хоёр мянга таван",
     "2005"
    ],
    [
     "Уай Комбинаторын",
     "Y Combinator-ын"
    ]
   ]
  },
  {
   "id": "G1",
   "voice": "G",
   "text": "Бид Кембрижийн нэг жижигхэн байшинд нуугдаж суудаг байлаа. Пол Грэм бидэнд өөрөө оройн хоол хийж өгдөг байсан."
  },
  {
   "id": "G2",
   "voice": "G",
   "text": "Тэр үед компани бүрийн гурван сар зүтгэж бүтээснийг өнөөдөр код бичдэг хиймэл оюун хэдхэн минутад хийчихнэ. Ердөө хорин жилийн өмнө шүү дээ."
  },
  {
   "id": "N4",
   "voice": "N",
   "text": "Үүнийг сонсоод хоёр янзаар бодож болно гэж тэр хэлсэн."
  },
  {
   "id": "G3",
   "voice": "G",
   "text": "Нэг бол «ганцхан даалгавар бүхэл бүтэн компани болчихлоо» гээд гунигла. Эсвэл «би дэлхийн хамгийн зоримог, галзуу компанийг эхлүүлж чадна» гэж бод."
  },
  {
   "id": "G4",
   "voice": "G",
   "text": "Салбар бүрийн мэргэжилтэн надтай хамт ажиллана. Өмнө нь боломжгүй байсан хэцүү технологийг ч бүтээж болно."
  },
  {
   "id": "N5",
   "voice": "N",
   "text": "Y Combinator-ын тэргүүн Гарри Таны хэлснээр хүнд технологийн компаниудын эзлэх хувь олон жил 5–10 хувь байсан бол одоо 25-д хүрч байна.",
   "tts": "Уай Комбинаторын тэргүүн Гарри Таны хэлснээр хүнд технологийн компаниудын эзлэх хувь олон жил тав, арван хувь байсан бол одоо хорин тавд хүрч байна.",
   "captionMap": [
    [
     "Уай Комбинаторын",
     "Y Combinator-ын"
    ],
    [
     "тав, арван",
     "5–10"
    ],
    [
     "хорин тавд",
     "25-д"
    ]
   ]
  },
  {
   "id": "G5",
   "voice": "G",
   "text": "Гурван сарын ажил дээр олон агент нэмбэл гайхалтай зүйл бүтнэ. Гарааны бизнесийн алтан үе ирнэ гэж би бодож байна."
  },
  {
   "id": "N6",
   "voice": "N",
   "text": "Гэвч залуусын дунд өөр яриа тарсан. Хиймэл оюуны том компанид орохгүй бол үүрд доод давхаргад үлдэнэ гэх."
  },
  {
   "id": "G6",
   "voice": "G",
   "text": "Хэрэв тэр үнэн байсан бол дэлхий маш муу газар болох байсан."
  },
  {
   "id": "G7",
   "voice": "G",
   "text": "Өнөөдөр байгуулагдсан компаниуд өмнөх үеийнхээс хавьгүй үнэ цэнтэй, хавьгүй нөлөөтэй болно гэж би мөрийцнө."
  },
  {
   "id": "N7",
   "voice": "N",
   "text": "Хиймэл оюун бүхнийг залгина гэсэн айдас нэг хэсэг ноёлж байсан. Одоо байдал эргэсэн гэж тэр ажиглажээ."
  },
  {
   "id": "G8",
   "voice": "G",
   "text": "Өмнө нь «бүх зүйл дууслаа» гэдэг байсан. Одоо «за, хийцгээе» гэдэг болсон."
  },
  {
   "id": "G9",
   "voice": "G",
   "text": "Үүнийг жил бүр дахин хэлж чадна гэж найдаж байна. Гэхдээ түүхийн яг энэ агшны хувьд бол эргэлзээгүй үнэн."
  },
  {
   "id": "N8",
   "voice": "N",
   "text": "Хоёрдугаар ангид: туршлага биш, хэрэгсэл ялна. Дагаад хүлээж байгаарай."
  }
 ],
