 "lines": [
  {
   "id": "N1",
   "voice": "N",
   "text": "Хиймэл оюуны бараг бүх том компани энэ хүний чип дээр тогтдог. Одоо тэр тагнуулын дуулианы төвд байна."
  },
  {
   "id": "N2",
   "voice": "N",
   "text": "Bloomberg-ийн мэдээлснээр Хуан гэр бүлээс гадуурх харилцаатай байснаа хүлээн зөвшөөрсөн. Америкийн албаныхан тэр эмэгтэйг Хятадын тагнуул гэж сэжиглэж байна.",
   "tts": "Блүмбэргийн мэдээлснээр Хуан гэр бүлээс гадуурх харилцаатай байснаа хүлээн зөвшөөрсөн. Америкийн албаныхан тэр эмэгтэйг Хятадын тагнуул гэж сэжиглэж байна.",
   "captionMap": [
    [
     "Блүмбэргийн",
     "Bloomberg-ийн"
    ]
   ]
  },
  {
   "id": "N3",
   "voice": "N",
   "text": "Одоо түүнийг компани нь ч, Америкийн засгийн газар ч шалгаж байна. Тэр ажилтнууддаа захидал бичсэн. Юу гэж бичсэнийг төгсгөлд нь үзнэ."
  },
  {
   "id": "N4",
   "voice": "N",
   "text": "Гэтэл хэдхэн долоо хоногийн өмнө бүх зүйл огт өөр байв. Дөрвөн өдөр, дөрвөн улс. Очсон газар бүрд нь хүмүүс түүнийг бүчиж авч байлаа."
  },
  {
   "id": "N5",
   "voice": "N",
   "text": "Тайваньд төрсөн. Америкт зоогийн газарт аяга угааж байсан. 1993 онд NVIDIA-г байгуулсан.",
   "tts": "Тайваньд төрсөн. Америкт зоогийн газарт аяга угааж байсан. Мянга есөн зуун ерэн гурван онд Энвидиаг байгуулсан.",
   "captionMap": [
    [
     "Мянга есөн зуун ерэн гурван",
     "1993"
    ],
    [
     "Энвидиаг",
     "NVIDIA-г"
    ]
   ]
  },
  {
   "id": "N6",
   "voice": "N",
   "text": "Тэр үед NVIDIA тоглоомын график чип хийдэг байв. Харин судлаачид тэр чипээр хиймэл оюун сургаж болохыг олж мэдэв.",
   "tts": "Тэр үед Энвидиа тоглоомын график чип хийдэг байв. Харин судлаачид тэр чипээр хиймэл оюун сургаж болохыг олж мэдэв.",
   "captionMap": [
    [
     "Энвидиа",
     "NVIDIA"
    ]
   ]
  },
  {
   "id": "N7",
   "voice": "N",
   "text": "Хуан бүхнээ үүнд дэнчин тавьсан. Өнөөдөр OpenAI, Google, Meta, Microsoft бүгдийн цөмд NVIDIA бий.",
   "tts": "Хуан бүхнээ үүнд дэнчин тавьсан. Өнөөдөр Оупэн Эй Ай, Гүүгл, Мета, Майкрософт бүгдийн цөмд Энвидиа бий.",
   "captionMap": [
    [
     "Оупэн Эй Ай,",
     "OpenAI,"
    ],
    [
     "Гүүгл,",
     "Google,"
    ],
    [
     "Мета,",
     "Meta,"
    ],
    [
     "Майкрософт",
     "Microsoft"
    ],
    [
     "Энвидиа",
     "NVIDIA"
    ]
   ]
  },
  {
   "id": "N8",
   "voice": "N",
   "text": "Тэр төрийн тэргүүнүүдтэй шууд утсаар ярьдаг хүн болсон."
  },
  {
   "id": "G1",
   "voice": "G",
   "text": "Хиймэл оюун хүн төрөлхтнийг мөхөөнө гэж үү? Миний хариулт: бүх зүйл бидний хяналтад байгаа. Чадавхыг ахиулах, аюулгүй болгох хоёр бол нэг ажил."
  },
  {
   "id": "N9",
   "voice": "N",
   "text": "OpenAI, Anthropic хоёр хиймэл оюун нь санаанд оромгүй үйлдэл хийснийг зарласан. Тэд үүнийг хашиж чадахгүй гэж байна гэж сэтгүүлч хэлэхэд:",
   "tts": "Оупэн Эй Ай, Антропик хоёр хиймэл оюун нь санаанд оромгүй үйлдэл хийснийг зарласан. Тэд үүнийг хашиж чадахгүй гэж байна гэж сэтгүүлч хэлэхэд:",
   "captionMap": [
    [
     "Оупэн Эй Ай,",
     "OpenAI,"
    ],
    [
     "Антропик",
     "Anthropic"
    ]
   ]
  },
  {
   "id": "G2",
   "voice": "G",
   "text": "Агентыг хашиж, хянаж болно. Чадахгүй бол турших ёсгүй, ашиглалтад оруулах ёсгүй. Хашихгүй, хянахгүй хөгжүүлэх нь маш өндөр эрсдэлтэй."
  },
  {
   "id": "N10",
   "voice": "N",
   "text": "Хиймэл оюун хүмүүсийг ажилгүй болгоно гэсэн айдас ч бий. Хуан үүнтэй санал нийлдэггүй."
  },
  {
   "id": "G3",
   "voice": "G",
   "text": "Хиймэл оюун ажлын байр бий болгодог. Үүнийг барьж байгуулах хэрэгтэй учраас барилга, цахилгаан, шугам хоолойн ажил нэмэгдэж байна."
  },
  {
   "id": "G4",
   "voice": "G",
   "text": "Хүн бүрийн ажил өөрчлөгдөнө. Өөрчлөлтийг эсэргүүцээд тэр алга болохгүй."
  },
  {
   "id": "N11",
   "voice": "N",
   "text": "Гэвч хүн бүртэй ярьдаг хүнд эрсдэл дагалддаг."
  },
  {
   "id": "N12",
   "voice": "N",
   "text": "Тэр эмэгтэй NVIDIA-гийн чипийг Зүүн өмнөд Азид хамгийн их авдаг компаниудын нэгд ажилладаг. Америкийн албаныхан уг компанийг Хятад руу чип нууцаар гаргасан гэж сэжиглэдэг.",
   "tts": "Тэр эмэгтэй Энвидиагийн чипийг Зүүн өмнөд Азид хамгийн их авдаг компаниудын нэгд ажилладаг. Америкийн албаныхан уг компанийг Хятад руу чип нууцаар гаргасан гэж сэжиглэдэг.",
   "captionMap": [
    [
     "Энвидиагийн",
     "NVIDIA-гийн"
    ]
   ]
  },
  {
   "id": "N13",
   "voice": "N",
   "text": "NVIDIA түүнийг огцруулах эсэхээ хэлэлцэж байгаа гэсэн мэдээлэл ч гарсан. Тэгээд тэр захидлаа бичсэн.",
   "tts": "Энвидиа түүнийг огцруулах эсэхээ хэлэлцэж байгаа гэсэн мэдээлэл ч гарсан. Тэгээд тэр захидлаа бичсэн.",
   "captionMap": [
    [
     "Энвидиа",
     "NVIDIA"
    ]
   ]
  },
  {
   "id": "G5",
   "voice": "G",
   "text": "Би гэр бүлээсээ, та бүхнээс уучлал гуйх ёстой. Би эхнэртээ үнэнч байгаагүй. Миний хийсэн зүйлд ямар ч шалтаг байхгүй."
  },
  {
   "id": "N14",
   "voice": "N",
   "text": "NVIDIA-гийн удирдах зөвлөл компанийн нууц алдагдсан гэх үндэслэл байхгүй гэж мэдэгдсэн. Хятад үүнийг гүтгэлэг гэж нэрлэсэн.",
   "tts": "Энвидиагийн удирдах зөвлөл компанийн нууц алдагдсан гэх үндэслэл байхгүй гэж мэдэгдсэн. Хятад үүнийг гүтгэлэг гэж нэрлэсэн.",
   "captionMap": [
    [
     "Энвидиагийн",
     "NVIDIA-гийн"
    ]
   ]
  },
  {
   "id": "N15",
   "voice": "N",
   "text": "Дуулиан гарахаас өмнө тэрээр ирээдүйн тухай ингэж хэлж байв."
  },
  {
   "id": "G6",
   "voice": "G",
   "text": "Эрсдэлийг би сайн мэднэ. Гэхдээ бидний бүтээх гайхалтай сайхан ирээдүйг харахгүй юм бол үүнийг юуны төлөө хийж байгаа юм бэ?"
  }
 ],
