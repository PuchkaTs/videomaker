 "headlines": [
  {
   "text": "ХИЙМЭЛ ОЮУН|ГАНЦ ХҮНЭЭС|ХАМААРЧ БОЛОХ УУ?",
   "tone": "accent",
   "big": true,
   "from": 0.1,
   "to": 7.97
  },
  {
   "text": "ГЭР БҮЛЭЭС ГАДУУРХ|ХАРИЛЦААГАА ХҮЛЭЭВ",
   "tone": "danger",
   "from": 10.27,
   "to": 15.52
  },
  {
   "text": "АМЕРИКИЙН СЭЖИГ:|ХЯТАДЫН ТАГНУУЛ",
   "tone": "danger",
   "from": 15.57,
   "to": 20.82
  },
  {
   "text": "ХЭДХЭН ДОЛОО ХОНОГИЙН|ӨМНӨ",
   "from": 20.87,
   "to": 23.886
  },
  {
   "text": "4 ӨДӨР,|4 УЛС",
   "tone": "accent",
   "from": 23.936,
   "to": 26.612
  },
  {
   "text": "ХҮМҮҮС ТҮҮНИЙГ|БҮЧИЖ АВЧ БАЙЛАА",
   "from": 26.662,
   "to": 30.7
  },
  {
   "text": "БҮХНЭЭ|ДЭНЧИН ТАВЬСАН",
   "from": 30.75,
   "to": 33.687
  },
  {
   "text": "БҮГДИЙН ЦӨМД|NVIDIA",
   "tone": "accent",
   "from": 33.737,
   "to": 37.869
  },
  {
   "text": "БҮГДИЙН ЦӨМД|NVIDIA",
   "tone": "accent",
   "from": 37.919,
   "to": 39.86
  },
  {
   "text": "ХҮН ТӨРӨЛХТӨН|МӨХӨХ ҮҮ?",
   "from": 39.91,
   "to": 46.06
  },
  {
   "text": "ХИЙМЭЛ ОЮУН|БИДНИЙ ХЯНАЛТАД",
   "tone": "accent",
   "from": 46.11,
   "to": 51.02
  },
  {
   "text": "АЖИЛГҮЙ|БОЛОХ УУ?",
   "tone": "danger",
   "from": 51.07,
   "to": 53.965
  },
  {
   "text": "АЖИЛГҮЙ|БОЛОХ УУ?",
   "tone": "danger",
   "from": 54.015,
   "to": 57.54
  },
  {
   "text": "ХҮН БҮРИЙН АЖИЛ|ӨӨРЧЛӨГДӨНӨ",
   "tone": "accent",
   "from": 57.64,
   "to": 63.02
  },
  {
   "text": "ХҮН БҮРТЭЙ ЯРЬДАГ ХҮНД|ЭРСДЭЛ ДАГАЛДДАГ",
   "tone": "danger",
   "from": 63.12,
   "to": 66.92
  },
  {
   "text": "ОГЦРУУЛЖ МАГАДГҮЙ|ГЭСЭН МЭДЭЭЛЭЛ",
   "tone": "danger",
   "from": 66.97,
   "to": 70.34
  },
  {
   "text": "ТЭГЭЭД ЗАХИДЛАА|БИЧСЭН",
   "from": 70.39,
   "to": 73.76
  },
  {
   "text": "«МИНИЙ ХИЙСЭНД|ШАЛТАГ БАЙХГҮЙ»",
   "tone": "danger",
   "from": 73.86,
   "to": 82.6
  },
  {
   "text": "ДУУЛИАНААС|ӨМНӨ",
   "from": 82.7,
   "to": 86.88
  },
  {
   "text": "САЙХАН ИРЭЭДҮЙГ|ХАРАХГҮЙ БОЛ ЯАХ ВЭ?",
   "tone": "accent",
   "from": 86.98,
   "to": 95.76
  }
 ],
