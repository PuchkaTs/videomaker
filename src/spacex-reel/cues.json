 "headlines": [
  {
   "text": "НАРНЫ ЭРЧИМ ХҮЧНИЙ|ИХ НАЯДНЫ НЭГ Ч БИШ",
   "from": 0.05,
   "to": 4.589
  },
  {
   "text": "БИД БҮРТГЭГДЭХГҮЙ Ч|БАЙНА",
   "tone": "accent",
   "from": 4.639,
   "to": 8.26
  },
  {
   "text": "ХАРЬ ГАРИГИЙНХАН|БИДЭНТЭЙ ЯРИХАД",
   "from": 8.36,
   "to": 14.71
  },
  {
   "text": "ГУРВАН ЗҮЙЛ|ХЭРЭГТЭЙ",
   "from": 18.11,
   "to": 26.58
  },
  {
   "text": "ДАХИН НИСДЭГ|ПУУЖИН",
   "from": 26.68,
   "to": 33.53
  },
  {
   "text": "ХАМГИЙН ТОМ|НИСДЭГ БИЕТ",
   "from": 33.58,
   "to": 38.178
  },
  {
   "text": "САТУРН V-ГЭЭС|2 ДАХИН ХҮЧТЭЙ",
   "tone": "accent",
   "from": 38.228,
   "to": 41.432
  },
  {
   "text": "ЦАГ ТУТАМ|НИСНЭ",
   "from": 41.482,
   "to": 45.15
  },
  {
   "text": "2500 ТОНН →|САЯ ТОНН",
   "tone": "accent",
   "from": 45.25,
   "to": 53.14
  },
  {
   "text": "ХИЙМЭЛ ОЮУНЫ|ХИЙМЭЛ ДАГУУЛ",
   "from": 53.19,
   "to": 57.597
  },
  {
   "text": "НАРНЫ ХАВТАН +|ХӨРГӨГЧ + ЛАЗЕР",
   "from": 57.647,
   "to": 60.989
  },
  {
   "text": "САНСАР ДАХЬ|КОМПЬЮТЕР",
   "tone": "accent",
   "from": 61.039,
   "to": 64.38
  },
  {
   "text": "ЖИЛ БҮР|10 ДАХИН",
   "from": 64.43,
   "to": 68.272
  },
  {
   "text": "1 ГИГАВАТТ →|1 ТЕРАВАТТ",
   "from": 68.322,
   "to": 72.163
  },
  {
   "text": "АМЕРИКААС|2 ДАХИН ИХ",
   "tone": "accent",
   "from": 72.213,
   "to": 75.19
  },
  {
   "text": "ЯАГААД ЖИЖГЭЭР|БОДОХ ВЭ?",
   "from": 75.24,
   "to": 78.222
  },
  {
   "text": "ЦОРЫН ГАНЦ ЗАМ:|САР",
   "tone": "accent",
   "from": 78.272,
   "to": 82.265
  },
  {
   "text": "САР ДЭЭР|ҮЙЛДВЭРЛЭНЭ",
   "from": 82.315,
   "to": 85.802
  },
  {
   "text": "ЦАХИЛГААН СОРОНЗОН|БУУГААР ХАРВАНА",
   "tone": "accent",
   "from": 85.852,
   "to": 89.34
  },
  {
   "text": "ХҮН БҮР САР РУУ|ЯДАЖ НЭГ УДАА",
