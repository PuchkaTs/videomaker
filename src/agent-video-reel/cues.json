 "versions": {
  "V01": {
   "name": "Анужин",
   "text": "Агентууд аа, сайн мэдээ байна. Таван бичлэгийг ердөө таван зуун мянгаар хийж өгнө. Гэхдээ удаан биш шүү.",
   "hookEnd": 7.44,
   "clipLen": 7.312,
   "speechAt": 0.2,
   "gainDb": 6.732
  },
  "V02": {
   "name": "Номин",
   "text": "Нэг бичлэг нь зуун мянга л гэсэн үг. Тавыг авбал таван зуун мянга. Удахгүй дуусна шүү.",
   "hookEnd": 6.64,
   "clipLen": 6.434,
   "speechAt": 0.2,
   "gainDb": 6.397
  },
  "V03": {
   "name": "Мишээл",
   "text": "Ремаксын агентууд аа, энэ бол танд. Таван бичлэг таван зуун мянган төгрөг. Хямдрал удахгүй дуусна.",
   "hookEnd": 7.44,
   "clipLen": 7.232,
   "speechAt": 0.2,
   "gainDb": 8.8
  },
  "V04": {
   "name": "Хулан",
   "text": "Хямдрал дуусах гэж байна. Агентын таван бичлэг таван зуун мянгахан төгрөг. Амжаад аваарай.",
   "hookEnd": 6.64,
   "clipLen": 6.434,
   "speechAt": 0.2,
   "gainDb": 8.5
  },
  "V05": {
   "name": "Марал",
   "text": "Таван зуун мянга. Таван бичлэг. Зөвхөн агентуудад. Зөвхөн одоохондоо.",
   "hookEnd": 6.48,
   "clipLen": 6.354,
   "speechAt": 0.2,
   "gainDb": 9.5
  },
  "V06": {
   "name": "Солонго",
   "text": "Байраа хурдан зармаар байна уу? Тэгвэл таван бичлэг хийлгээрэй. Одоо таван зуун мянгахан.",
   "hookEnd": 6.48,
   "clipLen": 6.254,
   "speechAt": 0.2,
   "gainDb": 7.9
  },
  "V07": {
   "name": "Энхжин",
   "text": "Зураг авалт ч хэрэггүй, зураглаач ч хэрэггүй. Таван бэлэн бичлэг таван зуун мянга. Одоохондоо л ийм үнэтэй.",
   "hookEnd": 7.76,
   "clipLen": 7.631,
   "speechAt": 0.2,
   "gainDb": 9.1
  },
  "V08": {
   "name": "Сувд",
   "text": "Танд нэг юм хэлэх үү? Агентын таван бичлэг одоо таван зуун мянга болчихсон байгаа. Удахгүй дуусна шүү.",
   "hookEnd": 6.72,
   "clipLen": 7.22,
   "speechAt": 0.2,
   "gainDb": 7
  },
  "V09": {
   "name": "Оюу",
   "text": "Агентууд аа! Таван бичлэг, таван зуун мянга. Одоо л амжина.",
   "hookEnd": 5.28,
   "clipLen": 5.057,
   "speechAt": 0.2,
   "gainDb": 7.9
  },
  "V10": {
   "name": "Намуун",
   "text": "Бүтэн сар тавих таван бичлэг. Таван зуун мянгахан төгрөг. Хямдрал дуусахаас өмнө аваарай.",
   "hookEnd": 6.4,
   "clipLen": 6.254,
   "speechAt": 0.2,
   "gainDb": 10.661
  },
  "V11": {
   "name": "Дөлгөөн",
   "text": "Бусад агент аль хэдийн бичлэгээр байраа зараад байна. Та ч эхлээрэй. Таван бичлэг таван зуун мянга, одоохондоо л.",
   "hookEnd": 7.44,
   "clipLen": 7.312,
   "speechAt": 0.2,
   "gainDb": 9.3
  },
  "V12": {
   "name": "Янжин",
   "text": "Хямдрал эхэллээ! Агентуудад таван бичлэгийг таван зуун мянгаар хийж өгч байна. Удахгүй дуусна шүү.",
   "hookEnd": 6.96,
   "clipLen": 6.752,
   "speechAt": 0.2,
   "gainDb": 7.9
  }
 },
