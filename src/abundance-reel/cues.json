 "headlines": [
  {
   "text": "ИРЭЭДҮЙД|БҮХ ЗҮЙЛ|ҮНЭГҮЙ БОЛНО",
   "tone": "accent",
   "big": true,
   "from": 0.1,
   "to": 10.29
  },
  {
   "text": "ЦАХИЛГААН МАШИН|БҮТЭХГҮЙ ГЭЖ БАЙСАН",
   "from": 12.64,
   "to": 15.593
  },
  {
   "text": "ПУУЖИНГ ДАХИН|АШИГЛАЖ БОЛОХГҮЙ",
   "from": 15.643,
   "to": 17.737
  },
  {
   "text": "ОДОО 500 ГАРУЙ УДАА|БУУЛГАСАН",
   "tone": "accent",
   "from": 17.787,
   "to": 20.74
  },
  {
   "text": "ХИЙМЭЛ ОЮУН, РОБОТЫН|ЭДИЙН ЗАСАГ",
   "from": 20.79,
   "to": 24.413
  },
  {
   "text": "ӨНӨӨГИЙНХӨӨС|САЯ ДАХИН ТОМ",
   "tone": "accent",
   "from": 24.463,
   "to": 27.626
  },
  {
   "text": "БОДОЖ ЧАДВАЛ|АВЧ ЧАДНА",
   "tone": "accent",
   "from": 27.676,
   "to": 30.84
  },
  {
   "text": "ЖИЛД 100 САЯ|МАШИН",
   "from": 30.89,
   "to": 35.141
  },
  {
   "text": "ЖИЛД 1–10 ТЭРБУМ|РОБОТ",
   "tone": "accent",
   "from": 35.191,
   "to": 39.92
  },
  {
   "text": "ДЭЛХИЙН БҮХ ҮЙЛДВЭР|ЕРДӨӨ 2%",
   "tone": "accent",
   "from": 40.02,
   "to": 48.97
  },
  {
   "text": "ТЕРАФАБЫГ БАРИНА,|ЭСВЭЛ ЧИПГҮЙ ХОЦОРНО",
   "from": 49.02,
   "to": 52.831
  },
  {
   "text": "ЧИП ХЭРЭГТЭЙ,|ТИЙМЭЭС БАРИНА",
   "tone": "accent",
   "from": 52.881,
   "to": 56.21
  },
  {
   "text": "ДЭЛХИЙ ДЭЭР|УЛАМ ХЭЦҮҮ",
   "from": 56.26,
   "to": 60.458
  },
  {
   "text": "САНСАРТ|ҮРГЭЛЖ НАРТАЙ",
   "tone": "accent",
   "from": 60.508,
   "to": 63.762
  },
  {
   "text": "2–3 ЖИЛИЙН ДАРАА|САНСАРТ ХЯМД",
   "tone": "accent",
   "from": 63.812,
   "to": 68.01
  },
  {
   "text": "НАРНЫ ЭРЧИМ ХҮЧНИЙ|САЯНЫ НЭГ",
   "tone": "accent",
   "from": 68.11,
   "to": 76.53
  },
  {
   "text": "ИРЭЭДҮЙД МӨНГӨ ГЭЖ|БАЙХГҮЙ",
   "tone": "accent",
   "from": 76.58,
   "to": 81.258
  },
  {
   "text": "ХҮН БҮРД|ЭЛБЭГ ДЭЛБЭГ",
   "from": 81.308,
   "to": 85.37
  },
  {
   "text": "БУРУУГААР ЭРГЭЖ|БОЛЗОШГҮЙ",
   "from": 85.42,
   "to": 89.159
  },
  {
   "text": "ГЭХДЭЭ ЗӨВ ТИЙШЭЭ|ЯВАХ БАЙХ",
