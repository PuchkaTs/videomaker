 "lines": [
  {
   "id": "N1",
   "voice": "N",
   "text": "OpenAI-г байгуулахад хүн бүхэн тэднийг солиотой гэж боддог байлаа. Харин Сэм Алтман тэр үеэ хамгийн том бэлэг байсан гэж ярьдаг.",
   "tts": "Оупэн Эй Айг байгуулахад хүн бүхэн тэднийг солиотой гэж боддог байлаа. Харин Сэм Алтман тэр үеэ хамгийн том бэлэг байсан гэж ярьдаг.",
   "captionMap": [
    [
     "Оупэн Эй Айг",
     "OpenAI-г"
    ]
   ]
  },
  {
   "id": "N2",
   "voice": "N",
   "text": "Гарри Тан сануулахад, OpenAI анх Y Combinator-ын дэргэдэх судалгааны төсөл байжээ. Хүн шиг сэтгэдэг хиймэл оюун бүтээнэ гэдэг тэр үед галзуу санаа байлаа.",
   "tts": "Гарри Тан сануулахад, Оупэн Эй Ай анх Уай Комбинаторын дэргэдэх судалгааны төсөл байжээ. Хүн шиг сэтгэдэг хиймэл оюун бүтээнэ гэдэг тэр үед галзуу санаа байлаа.",
   "captionMap": [
    [
     "Оупэн Эй Ай",
     "OpenAI"
    ],
    [
     "Уай Комбинаторын",
     "Y Combinator-ын"
    ]
   ]
  },
  {
   "id": "G1",
   "voice": "G",
   "text": "Арван жилийн өмнө бүгд биднийг шүүмжилдэг байсан: «Хүн шиг сэтгэдэг хиймэл оюун бүтээнэ гэдэг нь худлаа. Тэр битгий хэл, тэд хиймэл оюуны салбарыг дахиад унагана. Буруу, хариуцлагагүй хүмүүс.»"
  },
  {
   "id": "G2",
   "voice": "G",
   "text": "Та бүхэнд өгөх хамгийн чухал зөвлөгөө минь: олон нийт буруу байна гэдэгт үндэслэлтэй итгэж чадах зүйлээ ол. Тэгээд удаан хүлээх, хүмүүс тоохгүй байхад тэсвэртэй байхад бэлэн бай."
  },
  {
   "id": "N3",
   "voice": "N",
   "text": "Тэр үе их бухимдалтай байсан. Гэхдээ эргээд харахад энэ нь жинхэнэ бэлэг байсан гэж Алтман хэлж байна."
  },
  {
   "id": "G3",
   "voice": "G",
   "text": "Яагаад гэвэл бидэнтэй өрсөлдөх том компани байгаагүй. Судалгаагаа хийж, юмаа бүтээж, компаниа босгох цаг бидэнд байсан."
  },
  {
   "id": "G4",
   "voice": "G",
   "text": "Хэрэв би та нарын оронд байсан бол хэдэн жилийн өмнө боломжгүй байсан, харин одоо боломжтой болсон шинэ том зүйлийг хайх байсан."
  },
  {
   "id": "N4",
   "voice": "N",
   "text": "OpenAI-н хувьд тэр нь гүн сургалт гэнэт ажиллаж эхэлсэн мөч байв. Гэвч дэлхий үүнийг төдийлөн анзаарсангүй.",
   "tts": "Оупэн Эй Айн хувьд тэр нь гүн сургалт гэнэт ажиллаж эхэлсэн мөч байв. Гэвч дэлхий үүнийг төдийлөн анзаарсангүй.",
   "captionMap": [
    [
     "Оупэн Эй Айн",
     "OpenAI-н"
    ]
   ]
  },
  {
   "id": "G5",
   "voice": "G",
   "text": "Пол Грэмийн хэлдгээр, хүмүүс маш хурдан өсөж буй зүйлийг мэдэрч чаддаггүй. Яг одоо ийм зүйлс шинээр гарч ирж байна. Тэдгээрийг олоод итгэлээ алдахгүй бол бусад нь ойлгохгүй байгаад баярла."
  },
  {
   "id": "G6",
   "voice": "G",
   "text": "Бид хошигнодог байсан: хүн шиг сэтгэдэг хиймэл оюун бүтнэ гэж дэлхий дээр ердөө тавин хүн л итгэдэг. Гэхдээ санаа зовох хэрэггүй,"
  },
  {
   "id": "G7",
   "voice": "G",
   "text": "Танд олон хүн хэрэггүй. Юунд итгэдгээ ол, удаан хугацаанд хүмүүс ойлгохгүй байхаас бүү ай. Тэгээд тэр санаанд итгэдэг, жаахан өөр хүмүүсээ эргэн тойрондоо цуглуул."
  },
  {
   "id": "N8",
   "voice": "N",
   "text": "Дөрөвдүгээр ангид: хүнд өчүүхэн ч гэсэн тус бол. Дагаад хүлээж байгаарай."
  }
 ],
