 "lines": [
  {
   "id": "G1",
   "voice": "G",
   "text": "Санчир гараг руу аялах тасалбар худалдаж авч болдог бол гайхалтай биш гэж үү? Үнэндээ ирээдүйд бүх зүйл зүгээр л үнэгүй болно гэж би бодож байна."
  },
  {
   "id": "G2",
   "voice": "G",
   "text": "Хиймэл оюун, роботын эдийн засаг өнөөгийн дэлхийн эдийн засгаас сая дахин том болбол хүний ямар ч хэрэгцээг хангаж чадна. Бодож чадвал, авч чадна."
  },
  {
   "id": "N1",
   "voice": "N",
   "text": "Маскийн тооцоогоор, нарны эрчим хүчний ердөө саяны нэгийг ашиглаж чадвал эдийн засаг өнөөгийнхөөс сая дахин томорно."
  },
  {
   "id": "G3",
   "voice": "G",
   "text": "Зохиолч Иэн Бэнкс номдоо бараг зөв дүрсэлсэн гэж бодож байна. Ирээдүйд мөнгө гэж байхгүй, хүн бүрд элбэг дэлбэг байна."
  },
  {
   "id": "G4",
   "voice": "G",
   "text": "Буруугаар эргэхгүй гэсэн үг биш. Гэхдээ зөв тийшээ явах байх гэж бодож байна. Миний төсөөлж чадах хамгийн сайхан ирээдүй энэ."
  },
  {
   "id": "G5",
   "voice": "G",
   "text": "Тэгэхээр хэн ч Санчир гараг руу аялж чадна. Цөөн хэдэн хүн биш. Хүсвэл л болно."
  },
  {
   "id": "G6",
   "voice": "G",
   "text": "Цахилгаан машин бүтэхгүй гэж байсан. Пуужинг дахин ашиглах боломжгүй гэж байсан. Одоо бид таван зуу гаруй удаа буулгасан."
  },
  {
   "id": "G7",
   "voice": "G",
   "text": "Дэлхий жилд зуу орчим сая машин үйлдвэрлэдэг. Харин хүн дүрст роботыг жилд нэгээс арван тэрбумыг үйлдвэрлэнэ гэж би тооцож байна."
  },
  {
   "id": "N3",
   "voice": "N",
   "text": "Робот бүрд чип хэрэгтэй. Гэтэл дэлхийн бүх чипийн үйлдвэр нийлээд Маскийн төлөвлөгөөнд хэрэгтэйн ердөө хоёр хувийг л гаргадаг."
  },
  {
   "id": "G8",
   "voice": "G",
   "text": "Тэгэхээр бид Терафабыг барина, эсвэл чипгүй хоцорно. Чип бидэнд хэрэгтэй, тиймээс барина."
  },
  {
   "id": "G9",
   "voice": "G",
   "text": "Дэлхий дээр эрчим хүч нэмэх улам хэцүү болж байна. Харин сансарт үргэлж нартай. Хоёр гурван жилийн дараа хиймэл оюуныг сансарт ажиллуулах нь газар дээрхээс хямд болно гэж бодож байна."
  }
 ],
